# ============================================================================
# HOSTEL MONARCH — Environment Configuration
# ============================================================================
# Copy this file to ".env" and fill in your own Supabase project credentials
# to switch the app from DEMO MODE (fake in-memory data, Demo@123 logins) to
# LIVE MODE (real signups, real database, admin-approved accounts).
#
# How to get these values:
#   1. Go to https://supabase.com and create a free account + new project.
#   2. In your project, open Settings -> API.
#   3. Copy the "Project URL" into VITE_SUPABASE_URL below.
#   4. Copy the "anon public" key into VITE_SUPABASE_ANON_KEY below.
#   5. Open the SQL Editor in Supabase and run the contents of
#      supabase/schema.sql (in this repo) once, to create the required
#      tables, triggers and security policies.
#   6. Restart the dev server. The app will automatically detect these
#      variables and switch to live mode — the "Create Account" flow and
#      real admin approvals will become active.
#
# NEVER commit your real .env file or share these keys publicly.
# The anon key is safe for frontend use ONLY because of Row Level Security
# (RLS) policies defined in supabase/schema.sql — do not disable RLS.
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# Payment backend location (only needed once you deploy — leave blank for
# local dev, where Vite's proxy already forwards /api to localhost:4000).
#
# After deploying /server to a host like Render/Railway, put its public URL
# here, e.g. VITE_API_BASE_URL=https://hostel-monarch-backend.onrender.com
# ============================================================================
VITE_API_BASE_URL=
