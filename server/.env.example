# Copy this file to server/.env and fill in your real Razorpay credentials.
# NEVER commit server/.env — it is already covered by the root .gitignore pattern
# for .env* files, but double check before pushing to a public repo.

# Get these from https://dashboard.razorpay.com/app/keys
# Test keys (prefixed rzp_test_...) work immediately after signup, before KYC is approved.
# Live keys (prefixed rzp_live_...) only unlock once your KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Get this from Razorpay Dashboard -> Account & Settings -> Webhooks, when you create
# a webhook pointing at https://yourdomain.com/api/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Port this backend listens on locally (the Vite dev server proxies /api to this port).
PORT=4000
